includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - src
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    ignoreErrors:
        # Plugin constants are defined in the main file (outside src/).
        - '#^Constant AI_IMAGE_DISCLOSURE_(URL|VERSION|FILE|DIR) not found\.$#'
