#. Plugin Name of the plugin
#: ai-image-disclosure.php
msgid "AI Image Disclosure"
msgstr "AI Image Disclosure"

#. Plugin URI of the plugin
#: ai-image-disclosure.php
msgid "https://github.com/zirkeldesign/ai-image-disclosure"
msgstr ""

#. Description of the plugin
#: ai-image-disclosure.php
msgid "Label AI-generated images with a small, accessible badge. CSS only, detects IPTC and C2PA provenance on upload."
msgstr "Kennzeichnet KI-generierte Bilder mit einem kleinen, barrierefreien Etikett. Nur CSS, erkennt IPTC- und C2PA-Herkunftsangaben beim Hochladen."

#. Author of the plugin
#: ai-image-disclosure.php
msgid "zirkel.design"
msgstr ""

#. Author URI of the plugin
#: ai-image-disclosure.php
msgid "https://zirkel.design"
msgstr ""

#: src/Attachment/Fields.php:36
#: src/Attachment/Library.php:33
#: src/Settings.php:27
#: src/Settings.php:101
msgid "AI-generated"
msgstr "KI-generiert"

#. translators: %s: label text shown on the image
#: src/Attachment/Fields.php:43
#, php-format
msgid "Show the label \"%s\" on this image"
msgstr "Dieses Bild mit „%s“ kennzeichnen"

#. translators: %s: the default position, e.g. "Top right"
#: src/Attachment/Fields.php:51
#, php-format
msgid "Default (%s)"
msgstr "Standard (%s)"

#: src/Attachment/Fields.php:64
msgid "Label position"
msgstr "Position der Kennzeichnung"

#: src/Attachment/Fields.php:106
msgid "Required for realistic AI images. Ticked automatically on upload when the file declares itself as AI-generated."
msgstr "Pflicht für realistische KI-Bilder. Wird beim Hochladen automatisch gesetzt, wenn die Datei sich selbst als KI-generiert ausweist."

#: src/Attachment/Fields.php:110
msgid "Ticked on upload: the file declares itself as AI-generated in its IPTC metadata."
msgstr "Beim Hochladen gesetzt: Die Datei weist sich in ihren IPTC-Metadaten als KI-generiert aus."

#: src/Attachment/Fields.php:111
msgid "Ticked on upload: the file carries Content Credentials (C2PA) stating AI generation."
msgstr "Beim Hochladen gesetzt: Die Datei trägt Content Credentials (C2PA), die eine KI-Erzeugung angeben."

#: src/Attachment/Fields.php:112
msgid "Ticked on upload because of the file name. Please check."
msgstr "Beim Hochladen wegen des Dateinamens gesetzt. Bitte prüfen Sie das."

#: src/Attachment/Fields.php:113
msgid "Marked by hand."
msgstr "Von Hand gekennzeichnet."

#: src/Attachment/Library.php:46
msgid "Marked as AI-generated"
msgstr "Als KI-generiert gekennzeichnet"

#: src/Attachment/Library.php:56
msgid "Mark as AI-generated"
msgstr "Als KI-generiert kennzeichnen"

#: src/Attachment/Library.php:57
msgid "Remove AI marking"
msgstr "KI-Kennzeichnung entfernen"

#. translators: %d: number of images
#: src/Attachment/Library.php:98
#, php-format
msgid "%d image marked as AI-generated."
msgid_plural "%d images marked as AI-generated."
msgstr[0] "%d Bild als KI-generiert gekennzeichnet."
msgstr[1] "%d Bilder als KI-generiert gekennzeichnet."

#. translators: %d: number of images
#: src/Attachment/Library.php:100
#, php-format
msgid "AI marking removed from %d image."
msgid_plural "AI marking removed from %d images."
msgstr[0] "KI-Kennzeichnung von %d Bild entfernt."
msgstr[1] "KI-Kennzeichnung von %d Bildern entfernt."

#: src/Position.php:17
msgid "Top right"
msgstr "Oben rechts"

#: src/Position.php:18
msgid "Top left"
msgstr "Oben links"

#: src/Position.php:19
msgid "Bottom right"
msgstr "Unten rechts"

#: src/Position.php:20
msgid "Bottom left"
msgstr "Unten links"

#: src/Settings.php:83
msgid "AI-generated images"
msgstr "KI-generierte Bilder"

#: src/Settings.php:85
msgid "Images marked as AI-generated in the media library show a small label wherever they appear in a block."
msgstr "Bilder, die in der Mediathek als KI-generiert gekennzeichnet sind, tragen überall, wo sie in einem Block erscheinen, ein kleines Etikett."

#: src/Settings.php:90
msgid "Label text"
msgstr "Text der Kennzeichnung"

#: src/Settings.php:91
msgid "Default position"
msgstr "Standard-Position"

#: src/Settings.php:92
msgid "Options"
msgstr "Optionen"

#: src/Settings.php:102
msgid "Shown on every marked image. Leave empty for the translated default. Keep it plain: the label has to be understood at a glance."
msgstr "Erscheint auf jedem gekennzeichneten Bild. Leer bedeutet „KI-generiert“. Halten Sie ihn schlicht: Die Kennzeichnung muss auf einen Blick verständlich sein."

#: src/Settings.php:119
msgid "Applies to every image left on \"Default\". Changing it moves all of those labels at once."
msgstr "Gilt für alle Bilder, deren Position auf „Standard“ steht. Eine Änderung verschiebt alle diese Etiketten auf einmal."

#: src/Settings.php:125
msgid "Mark uploads whose file declares itself as AI-generated (IPTC or C2PA)"
msgstr "Hochgeladene Bilder kennzeichnen, die sich in der Datei als KI-generiert ausweisen (IPTC oder C2PA)"

#: src/Settings.php:126
msgid "Also mark uploads whose file name contains \"ai\" as a word of its own"
msgstr "Auch hochgeladene Bilder kennzeichnen, deren Dateiname „ai“ oder „ki“ als eigenes Wort enthält"

#: src/Settings.php:127
msgid "Add the label to the alternative text, so screen readers announce it"
msgstr "Die Kennzeichnung an den Alternativtext anhängen, damit Screenreader sie vorlesen"
